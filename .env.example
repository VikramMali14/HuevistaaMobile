# Copy this file to `.env` and fill it in. Values starting EXPO_PUBLIC_ are built
# into the app, so never put a secret here.

# The HueVista backend.
#   Android emulator talking to a backend on this computer: http://10.0.2.2:8080
#   A real phone on the same Wi-Fi: http://<this computer's LAN IP>:8080
#   Production: https://api.huevistaa.com (the default for release builds)
EXPO_PUBLIC_API_ORIGIN=http://10.0.2.2:8080

# The website — used for /pay/mobile (Razorpay), legal pages and shop links.
EXPO_PUBLIC_SITE_ORIGIN=https://huevistaa.com

# The painter website, printed on a colour board's reward page.
EXPO_PUBLIC_PAINTER_ORIGIN=https://painter.huevistaa.com
